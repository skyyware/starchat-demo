#!/usr/bin/env php
<?php
declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use Stage\Http\Request;
use Starchat\App;
use Starchat\Document;
use Starchat\Evidence;
use Starchat\Installation;
use Starchat\Knowledge;

$root = dirname(__DIR__);
$fail = static function (bool $condition, string $message): void {
    if (!$condition) { throw new RuntimeException($message); }
};
$installation = Installation::fromFile($root . '/installation.json');
$fail($installation->id() === 'stage', 'Stage identity changed');
$fail($installation->assetType() === 'project', 'Project asset must be explicitly selected');
$fail($installation->building(), 'Project building must be enabled for this installation');
$fail($installation->starter?->data['name'] === 'stage-app', 'The prepared minimal application is missing');
$fail(count(preg_split('/\s+/u', trim($installation->starter->data['summary']))) <= 4, 'Starter description exceeds four words');
$fail(class_exists(ZipArchive::class), 'Project downloads require the zip extension');
foreach (['answer', 'source-selection', 'review', 'project', 'project-review'] as $purpose) { $installation->instructions($purpose); }
$fail($installation->data['brand']['asset_origin'] === 'https://stage.dev', 'Shared theme owner changed');
$manifest = json_decode(file_get_contents($root . '/knowledge/sources.json'), true, flags: JSON_THROW_ON_ERROR);
$files = [];
$paths = [];
foreach ($manifest['documents'] as $source) {
    $relative = $source['file'];
    $fail(preg_match('~^knowledge/(stage|starchat)/[a-z0-9-]+\.md$~D', $relative) === 1, 'Invalid snapshot path');
    $file = $root . '/' . $relative;
    $fail(!isset($files[$file]), 'Duplicate snapshot');
    $files[$file] = true;
    $fail(hash_file('sha256', $file) === $source['sha256'], 'Snapshot changed after review: ' . $relative);
    $document = Document::read($file, 'stage');
    $fail($document->meta['id'] === $source['id'] && $document->meta['review_status'] === 'reviewed', 'Snapshot identity or review mismatch');
    $fail(hash('sha256', $document->body) === $source['body_sha256'], 'Reviewed body changed: ' . $relative);
    $fail($source['source'] === 'https://stage.dev' . $document->meta['public_path'], 'Missing canonical website source');
    $evidence = new Evidence([$document], $installation);
    $fail(in_array($source['source'], array_column($evidence->links, 'url'), true), 'Website guide unavailable to answers: ' . $relative);
    foreach ([$document->meta['source'], ...array_column($document->meta['links'] ?? [], 'url')] as $url) {
        $fail(!preg_match('~^https://github\.com/skyyware/starchat(?:/|$)~', $url), 'Private core used as a public citation');
    }
    $paths[] = $document->meta['public_path'];
}
$actual = glob($root . '/knowledge/*/*.md');
$fail(count($files) === count($actual) && array_diff($actual, array_keys($files)) === [], 'Unreviewed or missing knowledge');
$fail(count($paths) === count(array_unique($paths)), 'Duplicate resource route');
$runtime = $root . '/.runtime/check-' . bin2hex(random_bytes(6));
mkdir($runtime, 0700, true);
$previous = getenv('STARCHAT_RUNTIME');
putenv('STARCHAT_RUNTIME=' . $runtime);
try {
    $knowledge = new Knowledge($installation, $runtime . '/knowledge.sqlite');
    $fail($knowledge->rebuild() === count($files), 'Index count mismatch');
    $fail(count($knowledge->catalogue(true)) === count($files), 'Ineligible reviewed snapshot');
    foreach (['How do suggestion_labels differ from suggestions in the Starchat answer API?' => 'starchat-answer-api', 'When do reviewed contact offers expire in the Starchat answer API?' => 'starchat-answer-api', 'Starchat installation' => 'starchat-installation', 'verified email phone contact metadata' => 'starchat-contacts', 'PDF summary email conversation asset' => 'starchat-assets', 'How do I select a suggested question in Starchat 0.2.7? Are there number shortcuts?' => 'starchat-installation', 'How do I select a suggested question in Starchat 0.2.7?' => 'starchat-installation', 'Stage HTTP request' => 'stage-http', 'CMS published draft' => 'stage-cms-publication', 'Four random app ideas' => 'starchat-app-ideas', 'Continue a downloaded project with Claude Code' => 'starchat-agent-handoff', 'Download the current project ZIP' => 'starchat-building', 'What loading indicator appears during project ZIP creation?' => 'starchat-building'] as $query => $expected) {
        $ids = array_map(static fn (Document $document): string => $document->meta['id'], $knowledge->search($query));
        $fail(in_array($expected, $ids, true), 'Retrieval regression: ' . $query);
    }
    $app = new App($root, 'chat.stage.dev');
    $page = $app->handle(new Request('GET', '/'));
    $fail(str_contains($page->body, 'href="https://stage.dev/branding/stage.css"'), 'Shared stylesheet absent');
    $fail(str_contains($page->body, 'class="brand" href="https://stage.dev"'), 'Website return link absent');
    $fail(str_contains($page->body, 'data-history-key="starchat:stage:conversation"') && str_contains($page->body, 'data-migration-origin="https://stage.dev"'), 'Stage history migration changed');
    $fail(str_contains($page->headers['content-security-policy'], "script-src 'self';") && str_contains($page->headers['content-security-policy'], "connect-src 'self';"), 'Shared theme expanded executable access');
    $fail(!str_contains($page->body, 'id="project"'), 'Empty automatic project panel returned');
    $fail(preg_match('~<section id="actions"[^>]*aria-labelledby="actions-title"[^>]*data-assets="\[&quot;project&quot;\]"~', $page->body) === 1, 'Project action must have its own labelled area');
    $fail(preg_match('~<div id="suggestions"[^>]*data-assets=~', $page->body) === 0, 'Questions still own asset actions');
    $icons = $app->handle(new Request('GET', '/starchat/asset-icons.svg'));
    $sprite = '/starchat/asset-icons.svg?v=' . substr(hash('sha256', $icons->body), 0, 12);
    $fail($icons->status === 200 && str_contains($icons->body, 'id="project"'), 'Project code-folder icon absent');
    $fail(str_contains($page->body, 'data-asset-icons="' . $sprite . '"'), 'Dynamic card sprite version differs');
    $fail(!str_contains($page->body, 'class="asset-details"'), 'Project contents disclosure returned');
    $fail($app->handle(new Request('GET', '/starchat/project.js'))->status === 200, 'Project browser module absent');
    $fail($app->handle(new Request('GET', '/starchat/asset-flow.js'))->status === 200, 'Explicit asset creation module absent');
    $starter = $app->handle(new Request('GET', '/project/starter'));
    $prepared = json_decode($starter->body, true, flags: JSON_THROW_ON_ERROR);
    $fail($starter->status === 200 && $prepared['project'] === Starchat\ProjectHandoff::prepare($installation->starter)->data && str_starts_with($prepared['archive'], 'UEsDB'), 'Prepared starter download unavailable');
    foreach (['/', '/legal', '/sources', ...$paths] as $path) {
        $fail($app->handle(new Request('GET', $path))->status === 200, 'Public route failed: ' . $path);
    }
    foreach (['/installation.json', '/starters/minimal.json', '/knowledge/sources.json', '/vendor/autoload.php', '/.env', '/.runtime/check'] as $path) {
        $fail($app->handle(new Request('GET', $path))->status === 404, 'Private path exposed: ' . $path);
    }
    try {
        new App($root, 'esslingen.chat.stage.dev');
        throw new RuntimeException('Other installation host accepted');
    } catch (InvalidArgumentException) {}
} finally {
    putenv($previous === false ? 'STARCHAT_RUNTIME' : 'STARCHAT_RUNTIME=' . $previous);
    foreach (glob($runtime . '/*') as $file) { unlink($file); }
    rmdir($runtime);
}
echo count($files), " public source snapshots, retrieval, shared design, history and isolation verified\n";
